# Chỉ dùng cục bộ. Không đưa file .env thật lên GitHub.
PORT=3000

# Meta / Facebook
META_VERIFY_TOKEN=replace-with-a-long-random-string
META_APP_SECRET=replace-with-meta-app-secret
META_PAGE_ACCESS_TOKEN=replace-with-page-access-token
META_PAGE_ID=replace-with-page-id
META_GRAPH_VERSION=v26.0

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6
OPENAI_VECTOR_STORE_ID=vs_replace_me

# Thông tin công khai của đơn vị
UNIT_NAME=Công an phường Cửa Lò
DUTY_PHONE=replace-with-official-phone
OFFICE_ADDRESS=replace-with-official-address
